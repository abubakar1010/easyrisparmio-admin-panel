VITE_SERVER_URL=https://job-potal-as-sabbir.sarv.live/api/v1/

# -- Firebase web push (optional) ---------------------------------------------
# Leave blank to run without desktop notifications: the in-app bell polls every
# 30s regardless, so the dashboard works exactly the same without these.
# Values come from Firebase console -> Project settings -> General -> Your apps
# (Web app); the VAPID key from -> Cloud Messaging -> Web configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
